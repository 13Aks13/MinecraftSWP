diff --git a/apps/core-api/src/modules/settings/pipes/server-properties.pipe.ts b/apps/core-api/src/modules/settings/pipes/server-properties.pipe.ts
new file mode 100644
--- /dev/null
+++ b/apps/core-api/src/modules/settings/pipes/server-properties.pipe.ts
@@ -0,0 +1,38 @@
+import { SERVER_PROPERTY_ALLOWLIST } from "@mc/shared";
+import { BadRequestException, Injectable, type PipeTransform } from "@nestjs/common";
+
+const MAX_VALUE_LENGTH = 255;
+const ALLOWED = new Set<string>(SERVER_PROPERTY_ALLOWLIST);
+
+/**
+ * The body is a dynamic key/value map, so class-validator cannot describe it.
+ * This pipe checks the shape (plain object, allow-listed keys, scalar values)
+ * before SettingsService validates the per-property types.
+ */
+@Injectable()
+export class ServerPropertiesPipe implements PipeTransform<unknown, Record<string, string>> {
+  transform(value: unknown): Record<string, string> {
+    if (typeof value !== "object" || value === null || Array.isArray(value)) {
+      throw new BadRequestException("Body must be an object of server.properties values");
+    }
+
+    const result: Record<string, string> = {};
+    for (const [key, raw] of Object.entries(value)) {
+      if (!ALLOWED.has(key)) {
+        throw new BadRequestException(`Property "${key}" is not editable`);
+      }
+      if (typeof raw !== "string" && typeof raw !== "number" && typeof raw !== "boolean") {
+        throw new BadRequestException(`Property "${key}" must be a string, number or boolean`);
+      }
+      const text = String(raw);
+      if (text.length > MAX_VALUE_LENGTH) {
+        throw new BadRequestException(
+          `Property "${key}" is longer than ${MAX_VALUE_LENGTH} characters`,
+        );
+      }
+      result[key] = text;
+    }
+    return result;
+  }
+}
