+++ b/apps/core-api/src/modules/server/dto/allowlist.dto.ts
@@ -0,0 +1,26 @@
+import { Transform } from "class-transformer";
+import { IsString, Matches, MaxLength, MinLength, ValidateIf } from "class-validator";
+
+const trim = ({ value }: { value: unknown }): unknown =>
+  typeof value === "string" ? value.trim() : value;
+
+export class AllowListEntryDto {
+  @Transform(trim)
+  @IsString()
+  @MinLength(1)
+  @MaxLength(32)
+  @Matches(/^[\p{L}\p{N} _.-]+$/u, {
+    message: "name may contain letters, numbers, spaces, dots, dashes and underscores",
+  })
+  name!: string;
+
+  /** Optional; the UI sends an empty string when the field is left blank. */
+  @Transform(trim)
+  @ValidateIf((_object, value) => value !== undefined && value !== "")
+  @IsString()
+  @Matches(/^\d{16}$/, { message: "xuid must be exactly 16 digits" })
+  xuid?: string;
+}
