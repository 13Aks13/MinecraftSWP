new file mode 100644
--- /dev/null
+++ b/apps/core-api/src/common/operations/operation-lock.service.ts
@@ -0,0 +1,22 @@
+import { ConflictException, Injectable } from "@nestjs/common";
+
+/**
+ * Process-wide lock for operations that stop/replace the live Bedrock world
+ * (activate, backup, restore, clone, pack changes). core-api runs as a single
+ * instance, so an in-memory lock is sufficient.
+ */
+@Injectable()
+export class OperationLockService {
+  private current: string | null = null;
+
+  async runExclusive<T>(name: string, task: () => Promise<T>): Promise<T> {
+    if (this.current) {
+      throw new ConflictException(
+        `Operation "${this.current}" is already in progress; try again when it finishes`,
+      );
+    }
+    this.current = name;
+    try {
+      return await task();
+    } finally {
+      this.current = null;
+    }
+  }
+}
