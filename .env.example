# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Public URLs (Traefik) ─────────────────────────────────────────────────────
# The UI and API are served from the same origin; /api and /socket.io are routed
# to core-api by Traefik.
APP_HOST=app.localhost
ACME_EMAIL=legal@gmail.com
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8090

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=mc_platform
DB_USER=mc
DB_PASSWORD=change-me-in-production
DB_SSL=false
DB_LOGGING=false

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 48
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=12h
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
CORS_ORIGINS=http://localhost:5173,http://localhost,http://app.localhost

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_ROOT=./storage
DATA_ROOT=./data
MAX_UPLOAD_MB=500

# ── Bedrock / Docker ──────────────────────────────────────────────────────────
BEDROCK_CONTAINER=mc-bedrock
BEDROCK_LEVEL_NAME=active
DOCKER_SOCKET=/var/run/docker.sock
BACKUP_GRACEFUL_STOP=true
