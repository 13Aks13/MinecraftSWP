# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Number of reverse proxies in front of core-api (Traefik -> nginx -> api = 2).
# Too high a value lets clients spoof X-Forwarded-For and bypass the login limiter.
TRUST_PROXY_HOPS=2

# ── Public URLs (Traefik) ─────────────────────────────────────────────────────
# The UI and API are served from the same origin; /api and /socket.io are routed
# to core-api by Traefik.
APP_HOST=app.localhost
ACME_EMAIL=legal@gmail.com
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=mc_platform
DB_USER=mc
DB_PASSWORD=change-me-in-production
DB_SSL=false
DB_LOGGING=false
# Generate with: openssl rand -hex 24 (hex avoids URL-escaping in REDIS_URL)
REDIS_PASSWORD=change-me-in-production

# Redis
REDIS_URL=redis://redis:6379

# Import TTL
IMPORT_TEMP_TTL_HOURS=24

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 48
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=12h
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
CORS_ORIGINS=http://localhost:5173,http://localhost,http://app.localhost
# Swagger UI at /api/docs. Enabled by default outside production.
ENABLE_SWAGGER=false

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_ROOT=./storage
DATA_ROOT=./data
MAX_UPLOAD_MB=500

# ── Bedrock / Docker ──────────────────────────────────────────────────────────
BEDROCK_CONTAINER=mc-bedrock
BEDROCK_LEVEL_NAME=active
DOCKER_SOCKET=/var/run/docker.sock
BACKUP_GRACEFUL_STOP=true
