{
  "name": "minecraft-platform",
  "version": "1.11.0",
  "private": true,
  "description": "Minecraft Bedrock management platform (pnpm monorepo)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "engines": {
    "node": ">=26.12.1",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @mc/core-api --filter @mc/web-api dev",
    "dev:api": "pnpm --filter @mc/core-api start:dev",
    "dev:web": "pnpm --filter @mc/web-api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @mc/shared build && pnpm -r --filter '!@mc/worker' typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "db:migrate": "pnpm --filter @mc/core-api db:migrate",
    "db:revert": "pnpm --filter @mc/core-api db:revert",
    "compose:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d --build",
    "compose:down": "docker compose -f infra/docker-compose.yml --env-file .env down",
    "compose:logs": "docker compose -f infra/docker-compose.yml --env-file .env logs -f --tail=200",
    "prepare": "husky",
    "release": "semantic-release",
    "version:check": "node scripts/sync-package-versions.mjs --check",
    "version:sync": "node scripts/sync-package-versions.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3"
  }
}
